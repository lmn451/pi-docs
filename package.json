{
  "name": "pi-doc-injector",
  "version": "0.8.0",
  "description": "Inject project docs into Pi context when their filename appears in the conversation",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "*.d.ts",
    "docs/**/*.md",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck:core",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "docs",
    "context",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/pi-docs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "minimatch": "^11.0.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "typebox": "^1.3.27",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
